!app.py
!database.py
!analytics.py
!gemini.py
!prompts.py
!schemas.py
!config.py
!requirements.txt

# Explicitly ignore sensitive and unnecessary files
.env
.git
.gitignore
venv/
env/
__pycache__/
*.pyc
tests/
docs/
screenshots/
check_db.py
